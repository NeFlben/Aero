DATABASE_URL=
# Connections per server instance (default 10, 3 on Vercel).
DATABASE_POOL_MAX=
PGLITE_DATA_DIR=.data/pg
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Login is off by default (single local user). Set to "on" for accounts, required on any public deployment.
HANGAR_AUTH=
# "off" closes registration: only existing accounts can sign in (recommended for a personal deployment).
HANGAR_SIGNUP=
SMTP_URL=
MAIL_FROM=Hangar <no-reply@example.com>
UPLOAD_DIR=.data/uploads
# Photos in a private Vercel Blob store instead of UPLOAD_DIR (token from the store's settings).
BLOB_READ_WRITE_TOKEN=
ADMIN_EMAILS=

# Automatic photos of the real aircraft (by registration) from Planespotters.net.
# Their API requires a contact URL or e-mail; leave empty to turn the lookup off.
PLANESPOTTERS_CONTACT=

# Market prices: current eBay offers via the official Browse API (free keyset from developer.ebay.com,
# "Production" App ID and Cert ID). Each model is checked every MARKET_REFRESH_DAYS and stored, which
# builds a price history. Leave empty to turn it off.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_MARKETPLACE=EBAY_DE
MARKET_REFRESH_DAYS=7

# Photo search ("Search photo on the web" shows the first 10 hits to pick from). One key is enough:
# SERPER_API_KEY = Google Images results via serper.dev, BRAVE_SEARCH_API_KEY = Brave Search API.
SERPER_API_KEY=
BRAVE_SEARCH_API_KEY=

# Box photo recognition ("Take a photo of the box" in Add Aircraft): Claude reads brand, item number,
# scale, airline, type, registration, livery and barcode from up to 4 photos. Key from
# platform.claude.com. Leave empty to hide the button; without it no photo leaves the server.
ANTHROPIC_API_KEY=

# Serverless hosting (Vercel): the market refresh runs via GET /api/cron/market with
# "Authorization: Bearer <CRON_SECRET>" instead of a background timer. Any long random string.
CRON_SECRET=
# eBay Marketplace Account Deletion endpoint (needed to activate production keys)
EBAY_VERIFICATION_TOKEN=
EBAY_DELETION_ENDPOINT=
